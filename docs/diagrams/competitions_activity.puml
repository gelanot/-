@startuml
start

:Выбрать соревнование
и участника из списка;
:Ввести показатель
(время / очки / место);

if (Формат корректен?) then (да)
    :Сохранить результат
в базе данных;
    :Пересчитать рейтинг
и распределение мест;

    if (Все результаты внесены?) then (да)
        :Сформировать итоговый
протокол соревнования;
        :Экспортировать отчёт
(CSV / JSON);
        stop
    else (нет)
        :Перейти к внесению
следующего результата;
        back to "Выбрать соревнование
и участника из списка"
    endif
else (нет)
    :Повторить ввод показателя;
    back to "Ввести показатель
(время / очки / место)"
endif

@enduml
